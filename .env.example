# Remitlane configuration. Every variable has a working default for local
# development, so you only need a .env to change something. Copy to .env.

# --- Server ---
APP_ENV=development
PORT=5121
# Public URL of this instance. Sandbox providers call webhooks back here and
# seeded partner endpoints point at it. Defaults to http://localhost:$PORT.
APP_BASE_URL=http://localhost:5121
SHUTDOWN_TIMEOUT=10s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
LOG_LEVEL=info
LOG_FORMAT=text

# --- Postgres ---
DATABASE_URL=postgres://postgres@localhost:55421/remitlane?sslmode=disable
DB_MAX_CONNS=10
MIGRATE_ON_START=true
# Wipes and reloads the demo data on every start. Never in production.
SEED_ON_START=true

# --- Redis (asynq queues) ---
REDIS_ADDR=localhost:56421
REDIS_PASSWORD=
REDIS_DB=0

# --- Business rules ---
# Daily limits, reports and console dates follow this zone.
BUSINESS_TZ=Africa/Lagos
QUOTE_TTL=15m
DEFAULT_DAILY_LIMIT_USD=25000
BULK_MAX_ITEMS=500
API_RATE_LIMIT_PER_MIN=600

# --- Ops console ---
SESSION_SECRET=dev-only-session-secret-change-me
SESSION_TTL=12h
CONSOLE_SECURE_COOKIES=false
# Mounts /_dev (outbox, webhook receiver) and the provider sandbox page.
DEV_TOOLS_ENABLED=true

# --- FX rates (sandbox feed: fixed mid rates, units per 1 USD) ---
RATES_PROVIDER=fixed
RATES_USD_NGN=1540.00
RATES_USD_KES=129.37
RATES_USD_GHS=15.82
RATES_USD_UGX=3698.40

# --- Swiftpay (bank transfers) ---
# sandbox: in-process fake mounted at /_sandbox/swiftpay. live: real API.
SWIFTPAY_MODE=sandbox
SWIFTPAY_BASE_URL=http://localhost:5121/_sandbox/swiftpay
SWIFTPAY_API_KEY=sp_sandbox_key_7c1e0b
SWIFTPAY_WEBHOOK_SECRET=sp_sandbox_whsec_3f9d22
# Webhook format the sandbox sends (v2, or v1 for legacy accounts).
SWIFTPAY_API_VERSION=v2
SWIFTPAY_TIMEOUT=10s
SWIFTPAY_SANDBOX_DELAY=1500ms
SWIFTPAY_SANDBOX_HOLD_DELAY=4s
SWIFTPAY_SANDBOX_REVIEW_DELAY=8s
SWIFTPAY_SANDBOX_REVIEW_THRESHOLD_NGN=1000000

# --- MoMoBridge (mobile money) ---
MOMOBRIDGE_MODE=sandbox
MOMOBRIDGE_BASE_URL=http://localhost:5121/_sandbox/momobridge
MOMOBRIDGE_API_KEY=mmb_sandbox_key_51aa90
MOMOBRIDGE_WEBHOOK_SECRET=mmb_sandbox_whsec_8e27c4
MOMOBRIDGE_TIMEOUT=10s
MOMOBRIDGE_SANDBOX_DELAY=1200ms

# --- Email ---
# outbox: stored and shown at /_dev/outbox. log: only logged.
MAIL_PROVIDER=outbox
MAIL_FROM=Remitlane <no-reply@remitlane.com>
RECON_EMAIL_TO=finance@remitlane.com
OPS_ALERT_EMAIL=ops@remitlane.com
LOW_BALANCE_ALERT_USD=5000
